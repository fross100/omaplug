{
  "schemaVersion": 1,
  "id": "omaplug",
  "name": "Plugin Manager",
  "version": "1.4.0",
  "author": "Fross",
  "license": "MIT",
  "description": "Manage installed Omarchy plugins: enable/disable, update, install from git, and remove third-party plugins",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Plugin Manager",
    "description": "Enable/disable, update, install, and remove plugins",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "reviewModel": "claude-fable-5-1",
      "reviewEffort": "high",
      "reviewEnabled": true
    },
    "schema": [
      {
        "key": "reviewEnabled",
        "type": "boolean",
        "label": "Review plugins with Claude before installing",
        "defaultValue": true
      },
      {
        "key": "reviewModel",
        "type": "string",
        "label": "Pre-install review model (claude --model)",
        "defaultValue": "claude-fable-5-1"
      },
      {
        "key": "reviewEffort",
        "type": "string",
        "label": "Pre-install review effort (low, medium, high, xhigh, max)",
        "defaultValue": "high"
      }
    ]
  }
}
